API_URL=http://example.com
AUTH_SECRET=
# Used for metadataBase (SEO) and should be set in every deployment environment (e.g. Vercel's
# production env vars) to that environment's actual public URL.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Optional bounded request deadlines in milliseconds (1000-120000).
# Registration can finish on the API even if this deadline expires; it is never retried automatically.
REGISTRATION_REQUEST_TIMEOUT_MS=15000
AUTH_REQUEST_TIMEOUT_MS=10000
